{
  "buildCommand": "cd code-optimizer-explainer/frontend && npm install && npm run build",
  "outputDirectory": "code-optimizer-explainer/frontend/dist",
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/google8286d920d6fcd994.html",
      "destination": "/google8286d920d6fcd994.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
