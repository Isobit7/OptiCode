# ─────────────────────────────────────────────────────────────
# OptiCode Frontend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# FastAPI backend URL
# Local dev:    http://localhost:8000
# Vercel/Render deployed: https://your-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Supabase public config (safe to expose — anon key only, NOT service key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth Client ID (for Google Sign-In)
VITE_GOOGLE_CLIENT_ID=
